{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Mona Astro: Dev Server",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/site",
      "command": "npm run dev",
      "serverReadyAction": {
        "pattern": "(?:Local\\s+|Dev server (?:already )?running at )http://(?:localhost|127\\.0\\.0\\.1):([0-9]+)",
        "uriFormat": "http://localhost:%s/",
        "action": "openExternally"
      }
    }
  ]
}
